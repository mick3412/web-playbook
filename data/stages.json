{
  "version": 1,
  "asset_types": {
    "行銷網站": "多頁的產品或公司網站",
    "登陸頁": "單一活動或方案的一頁",
    "應用介面": "登入後使用的網頁應用、後台、儀表板",
    "設計系統": "色、字、間距、元件、圖示的規範與元件庫",
    "文件與說明頁": "說明文件、FAQ、條款頁"
  },
  "tracks": {
    "協作": "怎麼交代 agent、怎麼審、什麼時候停下來確認",
    "工具": "安裝、升級、授權、費用、資安"
  },
  "stages": [
    {
      "id": 0,
      "name": "開案",
      "purpose": "先講清楚這個網站或頁面要讓誰做什麼，後面每一步才有判斷標準。",
      "output": "brief：目的、受眾、範圍、技術",
      "steps": [
        {
          "id": "0.1",
          "name": "目的與受眾",
          "do": "一句話：給誰看、看完要他做什麼；定一個要量的指標"
        },
        {
          "id": "0.2",
          "name": "頁面類型與範圍",
          "do": "選類型，列出這次做哪些頁、不做哪些"
        },
        {
          "id": "0.3",
          "name": "產品設定檔與設計系統",
          "do": "讀產品專案的 `.agents/product-marketing.md`（和其他手冊共用）和設計系統的位置；沒有設計系統就排進第 2 階段"
        },
        {
          "id": "0.4",
          "name": "技術與託管",
          "do": "決定框架、託管平台、網域；公開頁和後台分開放"
        }
      ],
      "gates": [
        {
          "id": "G0.1",
          "text": "一句話說得出這頁要讓人做什麼"
        },
        {
          "id": "G0.2",
          "text": "技術和託管已決定"
        }
      ],
      "next": 1
    },
    {
      "id": 1,
      "name": "內容與架構",
      "purpose": "先有內容和架構，再談視覺。",
      "output": "頁面地圖與內容稿",
      "steps": [
        {
          "id": "1.1",
          "name": "文案來源",
          "do": "文案由行銷手冊產出並核准；這裡只排版不改說法",
          "ways": [
            "marketing-playbook 的銷售頁流程",
            "marketing-playbook:copywriting 技能"
          ],
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        },
        {
          "id": "1.2",
          "name": "頁面地圖",
          "do": "列出所有頁面和它們之間的連結；網站依少數幾個目的組織",
          "ways": [
            "marketing-playbook:site-architecture 技能"
          ]
        },
        {
          "id": "1.3",
          "name": "使用者流程",
          "do": "從進站到完成主要行動的每一步；應用介面要畫出各狀態（空、載入、錯誤）"
        },
        {
          "id": "1.4",
          "name": "一頁一個主軸",
          "do": "每頁只有一個主軸和一個主要行動"
        }
      ],
      "gates": [
        {
          "id": "G1.1",
          "text": "每頁都有一個主軸和一個主要行動"
        },
        {
          "id": "G1.2",
          "text": "內容稿已經核准"
        }
      ],
      "next": 2
    },
    {
      "id": 2,
      "name": "設計方向",
      "purpose": "定好風格和規則，後面每一頁都照同一套。",
      "output": "設計系統與線框",
      "steps": [
        {
          "id": "2.1",
          "name": "參考與風格",
          "do": "找 2–3 個參考，寫下要借的版面、節奏、字體處理",
          "ways": [
            "better-design 的靈感與設計系統工具",
            "extract-style 從網址擷取風格",
            "Design DNA 把參考轉成規格",
            "參考圖庫（Land-book、Supahero 等）截圖給 AI"
          ]
        },
        {
          "id": "2.2",
          "name": "設計系統",
          "do": "色（含深色模式）、字、間距、圓角、元件、圖示庫；寫成 tokens",
          "ways": [
            "design:design-system 技能",
            "better-design:create-design-system",
            "design-taste-frontend 技能",
            "拿 Awesome DESIGN.md 當範本",
            "logo-design-skill 做 Logo"
          ]
        },
        {
          "id": "2.3",
          "name": "線框",
          "do": "主要頁面的線框；核准後才做視覺",
          "types": [
            "行銷網站",
            "登陸頁",
            "應用介面",
            "文件與說明頁"
          ]
        }
      ],
      "gates": [
        {
          "id": "G2.1",
          "text": "設計系統寫成 tokens"
        },
        {
          "id": "G2.2",
          "text": "線框已經核准"
        }
      ],
      "next": 3
    },
    {
      "id": 3,
      "name": "視覺設計",
      "purpose": "把線框變成有個性、但清楚好讀的畫面。",
      "output": "設計稿或可預覽的頁面",
      "steps": [
        {
          "id": "3.1",
          "name": "版面",
          "do": "滿版優先，留白要有目的；手機寬度先想",
          "ways": [
            "frontend-design 技能",
            "design-taste-frontend 技能"
          ]
        },
        {
          "id": "3.2",
          "name": "影像與插圖",
          "do": "真實照片和清楚的圖示優先於線稿插圖；照片先轉正再檢查比例"
        },
        {
          "id": "3.3",
          "name": "動效",
          "do": "動效有目的、短、可關閉（尊重 reduced motion）",
          "ways": [
            "Motion Design 技能定時間和緩動",
            "GSAP（時間軸、捲動）",
            "Three.js（真的需要 3D 時）"
          ]
        },
        {
          "id": "3.4",
          "name": "深色與淺色",
          "do": "兩種模式都設計、都檢查對比"
        }
      ],
      "gates": [
        {
          "id": "G3.1",
          "text": "深色和淺色都看過"
        },
        {
          "id": "G3.2",
          "text": "設計稿已經核准"
        }
      ],
      "next": 4
    },
    {
      "id": 4,
      "name": "建置",
      "purpose": "照設計系統做成真的頁面。",
      "output": "可運作的頁面",
      "steps": [
        {
          "id": "4.1",
          "name": "元件",
          "do": "從設計系統的元件組頁面，不在頁面裡另寫一套樣式"
        },
        {
          "id": "4.2",
          "name": "響應式",
          "do": "手機、平板、桌機都可用；手機寬度沒有橫向捲動"
        },
        {
          "id": "4.3",
          "name": "表單與互動",
          "do": "鍵盤可操作、有錯誤訊息、送出後有狀態；表單資料只送到自己的後台"
        },
        {
          "id": "4.4",
          "name": "接入內容",
          "do": "用核准的內容，不留佔位文字"
        }
      ],
      "gates": [
        {
          "id": "G4.1",
          "text": "手機寬度沒有橫向捲動"
        },
        {
          "id": "G4.2",
          "text": "沒有佔位內容"
        }
      ],
      "next": 5
    },
    {
      "id": 5,
      "name": "品質",
      "purpose": "上線前量過，不憑感覺。",
      "output": "品質紀錄",
      "steps": [
        {
          "id": "5.1",
          "name": "無障礙",
          "do": "WCAG AA：對比、替代文字、鍵盤、標題層級",
          "ways": [
            "design:accessibility-review 技能",
            "web-design-guidelines 技能"
          ]
        },
        {
          "id": "5.2",
          "name": "效能",
          "do": "量 Core Web Vitals；圖片壓縮與尺寸、字型載入",
          "ways": [
            "vercel:performance-optimizer 子 agent"
          ]
        },
        {
          "id": "5.3",
          "name": "跨裝置",
          "do": "實際在手機和桌機的瀏覽器看一次",
          "ways": [
            "Playwright CLI 批次截圖"
          ]
        },
        {
          "id": "5.4",
          "name": "文案檢查",
          "do": "錯字、斷行、和核准稿一致",
          "ways": [
            "design:ux-copy 技能"
          ]
        }
      ],
      "gates": [
        {
          "id": "G5.1",
          "text": "無障礙和效能都有量測數字"
        }
      ],
      "next": 6
    },
    {
      "id": 6,
      "name": "SEO 與 AI 搜尋",
      "purpose": "讓搜尋引擎和 AI 助手讀得懂、引用得到。",
      "output": "SEO 紀錄",
      "steps": [
        {
          "id": "6.1",
          "name": "結構化資料",
          "do": "依頁面類型加 schema；不加產品沒有的評價標記",
          "ways": [
            "marketing-playbook:schema 技能"
          ],
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        },
        {
          "id": "6.2",
          "name": "meta 與分享預覽",
          "do": "標題、描述、分享預覽圖（OG）每頁都有",
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        },
        {
          "id": "6.3",
          "name": "sitemap 與索引",
          "do": "sitemap、robots、canonical；不想被收錄的頁加 noindex",
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        },
        {
          "id": "6.4",
          "name": "AI 搜尋健檢",
          "do": "跑一次 AI 搜尋能見度健檢，修完再上線",
          "ways": [
            "GEO Optimizer",
            "marketing-playbook:ai-seo 技能",
            "marketing-playbook:seo-audit 技能"
          ],
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        }
      ],
      "gates": [
        {
          "id": "G6.1",
          "text": "健檢跑過、問題修完"
        }
      ],
      "next": 7
    },
    {
      "id": 7,
      "name": "上線",
      "purpose": "上線是對外動作，由人核准。",
      "output": "上線紀錄",
      "steps": [
        {
          "id": "7.1",
          "name": "網域與部署",
          "do": "網域、HTTPS、轉址；部署到正式環境",
          "ways": [
            "vercel:deploy 技能"
          ]
        },
        {
          "id": "7.2",
          "name": "追蹤",
          "do": "裝統計並排除自己的瀏覽；確認量得到 0.1 的指標",
          "ways": [
            "marketing-playbook:analytics 技能"
          ]
        },
        {
          "id": "7.3",
          "name": "錯誤監控",
          "do": "前端錯誤和表單失敗有通知"
        },
        {
          "id": "7.4",
          "name": "上線檢查",
          "do": "照清單逐項檢查，由人按下上線"
        }
      ],
      "gates": [
        {
          "id": "G7.1",
          "text": "由人核准上線"
        }
      ],
      "next": 8
    },
    {
      "id": 8,
      "name": "量測與迭代",
      "purpose": "看數字決定改哪一頁。",
      "output": "成效紀錄",
      "steps": [
        {
          "id": "8.1",
          "name": "讀數據",
          "do": "依 0.1 的指標，在約定的時間點收數字"
        },
        {
          "id": "8.2",
          "name": "找機會頁",
          "do": "累積幾週後讀 Search Console，排名在第 2 頁的關鍵字對應的頁面優先改",
          "ways": [
            "Google Search Console MCP"
          ],
          "types": [
            "行銷網站",
            "登陸頁",
            "文件與說明頁"
          ]
        },
        {
          "id": "8.3",
          "name": "結論",
          "do": "寫一句結論和下一步：保留、改寫、停用"
        }
      ],
      "gates": [
        {
          "id": "G8.1",
          "text": "有數字和一句結論"
        }
      ],
      "next": 9
    },
    {
      "id": 9,
      "name": "回顧與收錄",
      "purpose": "讓每一個頁面都讓手冊變好一點。",
      "output": "實戰紀錄",
      "steps": [
        {
          "id": "9.1",
          "name": "記錄成效",
          "do": "把這次用過的條目和結果寫進 runs.csv"
        },
        {
          "id": "9.2",
          "name": "新做法與新工具",
          "do": "過程中發現的做法或工具，走收錄流程"
        },
        {
          "id": "9.3",
          "name": "更新手冊",
          "do": "跑 review，確認要升級、降級或移到 archive 的條目"
        }
      ],
      "gates": [
        {
          "id": "G9.1",
          "text": "至少一條回饋寫回手冊"
        }
      ],
      "next": null
    }
  ]
}
