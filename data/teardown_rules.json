 "外部工具": {
  "designlang": {
   "指令": [
    "npx",
    "-y",
    "designlang@13.4.1",
    "{url}"
   ],
   "輸出": "design-extract-output",
   "用途": "DTCG、Tailwind v4、shadcn、motion tokens、DESIGN.md 草稿（不合 Google 規格，只當證據）",
   "秒": 120
  },
  "dembrandt": {
   "指令": [
    "npx",
    "-y",
    "dembrandt@0.40.1",
    "{url}",
    "--dtcg"
   ],
   "輸出": "output",
   "用途": "語意色角色、字級、間距、動態（交叉驗證 designlang）",
   "秒": 240
  },
  "webanalyze": {
   "指令": [
    "{vendor}/webanalyze/webanalyze",
    "-host",
    "{url}",
    "-crawl",
    "0",
    "-output",
    "json",
    "-apps",
    "{vendor}/webanalyze/technologies.json"
   ],
   "用途": "技術棧（Wappalyzer 指紋的開源移植）",
   "秒": 60,
   "可選": true
  },
  "siteone": {
   "指令": [
    "siteone-crawler",
    "--url={url}",
    "--max-depth=1",
    "--max-visited-urls=30",
    "--output-json-file={out}/site/siteone.json",
    "--output-html-report={out}/site/siteone.html",
    "--disable-all-assets"
   ],
   "用途": "站點結構、SEO、效能、標頭（整站探勘）",
   "秒": 300,
   "可選": true
  },
  "singlefile": {
   "指令": [
    "npx",
    "-y",
    "single-file-cli@2.27.3",
    "{url}",
    "{out}/freeze/page.html",
    "--browser-executable-path=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
   ],
   "用途": "渲染後 DOM＋CSS 凍結成單檔（只在本機）",
   "秒": 180,
   "可選": true
  }
 },
